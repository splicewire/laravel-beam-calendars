{
  "name": "splicewire/laravel-beam-calendars",
  "description": "The generic calendar particle: dated events, recurrence series and an exactly-once firing ledger on beam-core, composition-free and engine-free by construction. Free-tier arm of the Beam family; depends DOWN on beam-core + the data-schemas foundation, never onto the composition/tower/satellite tiers that are additive to it.",
  "keywords": [
    "laravel",
    "schemastud",
    "beam",
    "calendar",
    "recurrence",
    "ics",
    "scheduling"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Stephen Rushing",
      "email": "stephen@rushing.dev"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^11.0|^12.0|^13.0",
    "illuminate/database": "^11.0|^12.0|^13.0",
    "illuminate/http": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "rushing/laravel-data-filters": "*",
    "rushing/laravel-permission-cascade": "*",
    "rushing/laravel-popcorn": "*",
    "rushing/laravel-schema-convergence": "*",
    "schemastud/laravel-data-schemas": "*",
    "spatie/laravel-data": "^4.0|^5.0",
    "spatie/laravel-package-tools": "^1.16",
    "splicewire/laravel-beam": "*"
  },
  "require-dev": {
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "pestphp/pest": "^2.0|^3.0",
    "wikimedia/composer-merge-plugin": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "Splicewire\\Beam\\Calendars\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Splicewire\\Beam\\Calendars\\Tests\\": "tests/"
    }
  },
  "extra": {
    "package-topology": {
      "because": "beam-calendars is a beam-family package: it depends DOWN on beam-core + the data-schemas foundation and must never require the composition/tower/satellite tiers that are ADDITIVE to it. The composition profile, the SOC-2 disclosure cell and the circuit-dispatch cell all live up in tower and contribute into this package's kind registry; nothing here may reach back for them.",
      "mustRequire": [
        "splicewire/laravel-beam",
        "schemastud/laravel-data-schemas",
        "rushing/laravel-popcorn",
        "rushing/laravel-permission-cascade"
      ],
      "mustNotRequire": [
        "splicewire/tower*",
        "splicewire/laravel-tower-*",
        "splicewire/laravel-satellite*",
        "splicewire/laravel-composition-*",
        "prism*",
        "prism-php/*",
        "laravel/mcp",
        "anthropic*",
        "openai*"
      ]
    },
    "branch-alias": {
      "dev-main": "1.0.x-dev"
    },
    "laravel": {
      "providers": [
        "Splicewire\\Beam\\Calendars\\BeamCalendarsServiceProvider"
      ]
    },
    "merge-plugin": {
      "include": [
        "composer.local.json"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "test": "vendor/bin/pest",
    "pint": "@php -d memory_limit=512M vendor/bin/pint"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "wikimedia/composer-merge-plugin": true
    }
  },
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/stephenr85/laravel-data-filters.git"
    },
    {
      "type": "git",
      "url": "https://github.com/stephenr85/laravel-permission-cascade.git"
    },
    {
      "type": "git",
      "url": "https://github.com/stephenr85/laravel-schema-convergence.git"
    },
    {
      "type": "git",
      "url": "https://github.com/splicewire/laravel-beam.git"
    },
    {
      "type": "git",
      "url": "https://github.com/schemastud/laravel-data-schemas.git"
    },
    {
      "type": "git",
      "url": "https://github.com/stephenr85/codegen.git"
    },
    {
      "type": "git",
      "url": "https://github.com/stephenr85/laravel-doctor.git"
    },
    {
      "type": "git",
      "url": "https://github.com/stephenr85/laravel-popcorn.git"
    },
    {
      "type": "git",
      "url": "https://github.com/stephenr85/laravel-versioning.git"
    },
    {
      "type": "git",
      "url": "https://github.com/schemastud/laravel-frame.git"
    },
    {
      "type": "git",
      "url": "https://github.com/stephenr85/php-popcorn.git"
    },
    {
      "type": "git",
      "url": "https://github.com/stephenr85/laravel-pipeline-registry.git"
    },
    {
      "type": "git",
      "url": "https://github.com/stephenr85/laravel-data-schemas-scribe.git"
    }
  ]
}
